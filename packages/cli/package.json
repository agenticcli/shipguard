{
  "name": "@agenticcli/shipguard",
  "version": "0.13.0",
  "description": "Open source CLI that scans AI-written code for secrets, auth, webhook and deploy flaws. For Claude Code, Codex, Cursor.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "shipguard": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "build:publish": "SHIPGUARD_PUBLISHED_BUILD=1 tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build:publish && bash \"$(git rev-parse --show-toplevel)/scripts/release-gate.sh\"",
    "test": "vitest run",
    "test:slow": "VITEST_SLOW=1 vitest run tests/slow",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.0",
    "minimatch": "^11.0.1",
    "re2js": "2.8.7",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.4"
  },
  "devDependencies": {
    "@agenticcli/matcher-contract": "workspace:*",
    "@agenticcli/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "shipguard",
    "agenticcli",
    "open-source",
    "security-scanner",
    "secret-scanner",
    "secret-detection",
    "claude-code",
    "claude-code-security",
    "codex",
    "codex-cli",
    "codex-security",
    "cursor",
    "ai-agents",
    "ai-coding-agent",
    "ai-agent-security",
    "ai-generated-code",
    "ai-code",
    "security-review",
    "pre-commit",
    "pre-commit-hook",
    "github-actions",
    "ci",
    "nextjs",
    "stripe-webhook",
    "leaked-api-key"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "AgenticCLI",
    "url": "https://agenticcli.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticcli/shipguard.git"
  },
  "homepage": "https://agenticcli.dev/shipguard?utm_source=npm_homepage&utm_medium=package&utm_campaign=shipguard_evergreen",
  "bugs": {
    "url": "https://github.com/agenticcli/shipguard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
